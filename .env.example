# Yapay zekâ asistanını açmak için "true" yapın. Boş bırakılırsa asistan kapalıdır ve site
# ücretsiz statik barındırmada yayınlanabilir. Asistan açıkken sunuculu barındırma ve API anahtarı gerekir.
NEXT_PUBLIC_ASSISTANT_ENABLED=

# Claude API anahtarı (https://platform.claude.com adresinden alınır). Asistan açıksa zorunlu.
ANTHROPIC_API_KEY=

# İsteğe bağlı: asistanın kullanacağı model. Boş bırakılırsa claude-opus-5-5 kullanılır.
# Daha düşük maliyet için: claude-haiku-5-5
ANTHROPIC_MODEL=
